PORT=3001
NODE_ENV=development

MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/codescribe

JWT_SECRET=change_me_in_production_use_a_long_random_string
JWT_EXPIRES_IN=7d

GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

REDIS_HOST=localhost
REDIS_PORT=6379

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=shared_secret_between_nestjs_and_python

# Must be exactly 32 characters for AES-256
GITHUB_TOKEN_ENCRYPTION_KEY=12345678901234567890123456789012

THROTTLE_TTL=60
THROTTLE_LIMIT=10

FRONTEND_URL=http://localhost:5173
