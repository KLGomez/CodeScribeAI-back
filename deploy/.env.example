# ========================================================
# Variables de Entorno Globales - CodeScribe AI (Docker)
# ========================================================

ENVIRONMENT=production
NODE_ENV=production
FRONTEND_PORT=80
FRONTEND_URL=http://localhost
VITE_API_URL=http://localhost:3001/api

# Google Gemini AI Engine
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-pro

# Secretos Internos y Criptografía (Mínimo 32 caracteres)
AI_SERVICE_SECRET=CHANGE_ME_INTERNAL_SECRET_MIN_16_CHARS
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
GITHUB_TOKEN_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_EXACT_KEY_123

# GitHub OAuth 2.0
GITHUB_CLIENT_ID=CHANGE_ME_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=CHANGE_ME_GITHUB_CLIENT_SECRET
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback
GITHUB_FALLBACK_TOKEN=CHANGE_ME_GITHUB_PAT_READ_ONLY

# Notion OAuth 2.0 Integration
NOTION_CLIENT_ID=CHANGE_ME_NOTION_CLIENT_ID
NOTION_CLIENT_SECRET=CHANGE_ME_NOTION_CLIENT_SECRET
NOTION_REDIRECT_URI=http://localhost/auth/notion/callback
